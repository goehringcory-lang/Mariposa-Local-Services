generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Provider {
  id                   String         @id @default(cuid())
  name                 String
  phone                String
  email                String
  description          String
  categoryId           String
  category             Category       @relation(fields: [categoryId], references: [id])
  areaServed           String         @default("Mariposa & Surrounding Areas")
  status               String         @default("PENDING")
  /// When the submitter checked the "I agree" box for the Business Listing
  /// Terms and Terms of Use. Set server-side at submission. Null means the
  /// listing predates the terms, not that consent was skipped.
  acceptedTermsAt      DateTime?
  /// Which version of the terms was accepted, by effective date (see
  /// LEGAL_EFFECTIVE_DATE). Lets us tell who agreed to which revision when the
  /// terms change, rather than having to assume everyone accepted the latest.
  acceptedTermsVersion String?
  /// Unguessable token for the emailed one-click acceptance link
  /// (/accept-terms/[token]). Only set for listings created before the terms
  /// existed, which is why it's nullable — new signups accept at submission
  /// time and never need a link.
  termsToken           String?        @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  reviews              Review[]
  contactEvents        ContactEvent[]
}

/// A recorded intent-to-contact — currently a visitor tapping a provider's
/// phone number. These are what let us tell a provider how much business the
/// directory actually sent them, so the counts need to be honest: writes are
/// deduplicated per visitor (see DEDUPE_WINDOW_MINUTES in the contact route)
/// rather than counting every tap.
model ContactEvent {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type       String   @default("PHONE_TAP")
  /// Which page the tap came from — "category" or "provider".
  source     String   @default("unknown")
  /// Salted hash of the visitor's IP. Used only for deduplication and rate
  /// limiting; the raw address is never stored.
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([providerId, createdAt])
  @@index([ipHash, createdAt])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  sortOrder   Int        @default(0)
  providers   Provider[]
}

model Review {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  authorName String
  approved   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
